---
import { url } from '../lib/url';
// "What we do": bento grid of photo tiles. One large featured service, eight smaller ones.
// Photos live at src/assets/photos/services/<slug>.jpg (Unsplash, free licence).
import Icon from './Icon.jsx';
import Photo from './Photo.astro';
import { photoPath } from '../lib/photos';
import { services } from '../data/site';

const items = services
  .filter((s) => s.group === 'web')
  .slice(0, 9)
  .map((s) => ({ ...s, img: photoPath(`/images/services/${s.slug}.jpg`) }));
const btnLine = 'btn !rounded-[2px] border border-navy/30 px-7 py-3.5 text-[13px] font-bold uppercase tracking-[.14em] text-navy hover:border-navy hover:bg-navy hover:text-white';
---
<section class="relative overflow-clip bg-ivory py-20 md:py-28" data-svc>
  <div class="container-x relative">
    <!-- header -->
    <div class="grid gap-6 lg:grid-cols-[7fr_5fr] lg:items-end lg:gap-20">
      <div>
        <p class="eyebrow" data-svc-fade>What we do</p>
        <h2 class="h-classic mt-4" data-svc-title>Web development, <em class="text-gold">crafted</em> with care</h2>
      </div>
      <p class="lead" data-svc-fade>Everything you need to plan, build and grow a website, handled by one team.</p>
    </div>

    <!-- bento grid -->
    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:auto-rows-[15rem] lg:gap-5">
      {items.map((s, i) => {
        const big = i === 0;
        return (
          <li class={big ? 'sm:col-span-2 lg:row-span-2' : ''} data-svc-card>
            <a href={url(`/services/${s.slug}`)} class={`svc-tile group relative block h-full overflow-hidden rounded-2xl bg-navy ${big ? 'min-h-[22rem]' : 'min-h-[15rem]'}`}>
              {s.img && <Photo src={s.img} alt="" sizes={big ? '(min-width: 640px) 50vw, 100vw' : '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw'} loading="lazy" class="svc-img absolute inset-0 size-full object-cover" data-svc-img />}
              <span aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-navy via-navy/45 to-navy/5"></span>
              <span aria-hidden="true" class="absolute inset-0 bg-navy/40 opacity-0 transition-opacity duration-500 group-hover:opacity-100"></span>
              <span aria-hidden="true" class="pointer-events-none absolute inset-2.5 rounded-xl border border-transparent transition-colors duration-500 group-hover:border-gold-soft/50"></span>

              <span class={`absolute inset-x-0 bottom-0 block ${big ? 'p-8 md:p-10' : 'p-5 md:p-6'}`}>
                <span class={`grid place-items-center rounded-xl border border-white/25 bg-white/10 text-white backdrop-blur-sm transition-colors duration-500 group-hover:border-gold-soft group-hover:bg-gold-soft group-hover:text-navy ${big ? 'size-12' : 'size-10'}`} data-svc-icon>
                  <Icon name={s.icon} size={big ? 22 : 18} strokeWidth={1.6} />
                </span>
                <span class={`mt-4 block font-serif leading-tight tracking-[-0.015em] text-white ${big ? 'text-[34px] md:text-[40px]' : 'text-[20px]'}`}>{s.title}</span>
                <span class={`svc-more grid ${big ? 'is-big' : ''}`}>
                  <span class="overflow-hidden">
                    <span class={`block pt-2 leading-relaxed text-white/80 ${big ? 'max-w-md text-[16px]' : 'text-[14px]'}`}>{s.summary}</span>
                  </span>
                </span>
                <span class="mt-3 inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[.18em] text-gold-soft opacity-0 transition-opacity duration-500 group-hover:opacity-100 group-focus-visible:opacity-100">
                  Explore <Icon name="ArrowRight" size={13} strokeWidth={2.2} className="transition-transform duration-300 group-hover:translate-x-1" />
                </span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>

    <div class="mt-14 text-center" data-reveal><a href={url('/services')} class={btnLine}>View all services</a></div>
  </div>
</section>

<style is:global>
  /* Hover: photo zooms; small tiles reveal their summary (the featured tile always shows it) */
  .svc-tile .svc-img { transform: scale(1.03); transition: transform 1.4s cubic-bezier(.2,.7,.2,1); }
  .svc-tile:hover .svc-img, .svc-tile:focus-visible .svc-img { transform: scale(1.12); }
  .svc-tile .svc-more { grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows .6s cubic-bezier(.2,.7,.2,1), opacity .4s ease; }
  .svc-tile .svc-more.is-big,
  .svc-tile:hover .svc-more, .svc-tile:focus-visible .svc-more { grid-template-rows: 1fr; opacity: 1; }
  @media (hover: none) { .svc-tile .svc-more { grid-template-rows: 1fr; opacity: 1; } }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(ScrollTrigger, SplitText);

  const section = document.querySelector<HTMLElement>('[data-svc]');
  if (section) {
    const q = gsap.utils.selector(section);
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      const st = { trigger: section, start: 'top 75%' };

      SplitText.create(q('[data-svc-title]'), { type: 'lines', mask: 'lines', autoSplit: true,
        onSplit: (self) => gsap.from(self.lines, { yPercent: 110, duration: 1.1, stagger: 0.12, ease: 'expo.out', scrollTrigger: st }),
      });
      gsap.from(q('[data-svc-fade]'), { y: 20, autoAlpha: 0, duration: 0.9, stagger: 0.15, ease: 'power3.out', delay: 0.2, scrollTrigger: st });

      // Tiles: wipe open upward with the photo settling from a zoom, then the icon pops.
      // Hidden up front so nothing flashes before its row scrolls in.
      const cards = q('[data-svc-card]') as HTMLElement[];
      gsap.set(cards, { autoAlpha: 0 });
      ScrollTrigger.batch(cards, {
        start: 'top 90%',
        once: true,
        onEnter: (batch) => batch.forEach((card, i) => {
          gsap.timeline({ delay: i * 0.1 })
            .set(card, { autoAlpha: 1 })
            .from(card.querySelector('a'), { clipPath: 'inset(100% 0 0 0 round 16px)', duration: 1.2, ease: 'expo.inOut', clearProps: 'clipPath' })
            .from(card.querySelector('[data-svc-img]'), { scale: 1.35, duration: 1.6, ease: 'expo.out', clearProps: 'transform' }, '<0.2')
            .from(card.querySelector('[data-svc-icon]'), { scale: 0, rotate: -90, duration: 0.7, ease: 'back.out(2)' }, '-=1.1');
        }),
      });

      return () => gsap.set(cards, { clearProps: 'all' });
    });
  }
</script>
