---
import { url } from '../lib/url';
import { company } from '../data/site';
import Icon from './Icon.jsx';
const year = new Date().getFullYear();

const columns = [
  {
    title: 'Company',
    links: [['About us', '/about'], ['Services', '/services'], ['Blog', '/blog'], ['Career', '/career'], ['Contact us', '/contact']],
  },
  {
    title: 'Other links',
    links: [['Domain registration', 'https://sunsys.supersite2.myorderbox.com/'], ['Whois lookup', 'https://sunsys.supersite2.myorderbox.com/domain-registration/domain-whois-lookup.php'], ['Customer login', 'https://sunsys.myorderbox.com/servlet/LoginServlet?role=customer&currenturl=https://sunsys.myorderbox.com'], ['Reseller login', 'https://sunsys.myorderbox.com/servlet/AuthServlet?validatenow=false&role=reseller&currenturl=https://sunsys.myorderbox.com'], ['Sitemap', '/sitemap']],
  },
];

const social = [
  ['Facebook', company.social.facebook, 'M14 8h3V4h-3c-2.8 0-4 1.8-4 4v2H8v4h2v8h4v-8h3l1-4h-4V8.5c0-.3.2-.5.5-.5Z'],
  ['Instagram', company.social.instagram, 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Zm5 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm5.5-1.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z'],
  ['X', company.social.x, 'M4 4h4.5l4 5.6L17 4h3l-6.1 7.2L21 20h-4.5l-4.4-6L7 20H4l6.7-7.8Z'],
  ['LinkedIn', company.social.linkedin, 'M4 9h4v11H4Zm2-6a2 2 0 1 1 0 4 2 2 0 0 1 0-4Zm4 6h3.8v1.6c.6-1 1.9-1.9 3.7-1.9 3.6 0 4.5 2.3 4.5 5.4V20h-4v-5.3c0-1.3-.3-2.7-2-2.7s-2 1.3-2 2.7V20h-4Z'],
];
---
<footer class="relative overflow-hidden bg-[#041d3a] text-white/65">
  <!-- soft gold glow + top hairline -->
  <div aria-hidden="true" class="pointer-events-none absolute -top-48 left-1/2 h-96 w-[56rem] -translate-x-1/2 rounded-full bg-gold/10 blur-3xl"></div>
  <div aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold/50 to-transparent"></div>

  <div class="container-x relative">
    <!-- invitation band -->
    <div class="flex flex-col items-start justify-between gap-8 border-b border-gold/20 py-14 md:flex-row md:items-center">
      <div>
        <p class="eyebrow">Let’s talk</p>
        <p class="mt-4 font-serif text-[30px] font-light leading-tight tracking-[-0.02em] text-white md:text-[42px]">Have a project in <em class="text-gold-soft">mind</em>?</p>
      </div>
      <div class="flex flex-wrap items-center gap-6">
        <a href={url('/contact?type=quote')} class="group inline-flex items-center gap-3 rounded-[2px] border border-gold-soft/60 px-7 py-3.5 text-[13px] font-bold uppercase tracking-[.14em] text-gold-soft transition-colors hover:border-gold-soft hover:bg-gold-soft hover:text-navy">
          Get a free quote
          <Icon name="ArrowRight" size={15} strokeWidth={2} className="transition-transform duration-300 group-hover:translate-x-1" />
        </a>
      </div>
    </div>

    <!-- main -->
    <div class="grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1.1fr_1.3fr] lg:gap-10">
      <div>
        <img src={url('/logo-white.png')} alt="Sunsys Technologies" width="429" height="89" class="h-10 w-auto" loading="lazy" />
        <p class="mt-6 max-w-xs text-[15px] leading-relaxed">
          Website design, development and hosting from Bengaluru since {company.founded}.
        </p>
        <ul class="mt-8 flex gap-2.5">
          {social.map(([label, href, d]) => (
            <li>
              <a href={href} aria-label={label} class="grid size-10 place-items-center rounded-full border border-gold-soft/30 text-gold-soft transition-all duration-300 hover:-translate-y-0.5 hover:border-gold-soft hover:bg-gold-soft hover:text-navy">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d={d} /></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      {columns.map((col) => (
        <nav aria-label={col.title}>
          <p class="font-serif text-xl text-white">{col.title}</p>
          <span aria-hidden="true" class="mt-3 flex items-center gap-1.5"><span class="h-px w-8 bg-gold"></span><span class="size-1 rotate-45 bg-gold"></span></span>
          <ul class="mt-6 space-y-3 text-[15px]">
            {col.links.map(([label, href]) => (
              <li>{href.startsWith('http')
                ? <a href={href} target="_blank" rel="noopener noreferrer" class="ft-link hover:text-gold-soft">{label}<span class="sr-only"> (opens in a new tab)</span></a>
                : <a href={url(href)} class="ft-link hover:text-gold-soft">{label}</a>}</li>
            ))}
          </ul>
        </nav>
      ))}

      <div>
        <p class="font-serif text-xl text-white">Visit us</p>
        <span aria-hidden="true" class="mt-3 flex items-center gap-1.5"><span class="h-px w-8 bg-gold"></span><span class="size-1 rotate-45 bg-gold"></span></span>
        <ul class="mt-6 space-y-5 text-[15px]">
          <li class="flex gap-3">
            <Icon name="MapPin" size={18} strokeWidth={1.5} className="mt-0.5 shrink-0 text-gold-soft" />
            <a href={url('/contact')} class="leading-relaxed hover:text-white">{company.address}</a>
          </li>
          <li class="flex gap-3">
            <Icon name="Clock" size={18} strokeWidth={1.5} className="mt-0.5 shrink-0 text-gold-soft" />
            <span>{company.hours}</span>
          </li>
        </ul>
      </div>
    </div>

  </div>

  <!-- bottom bar -->
  <div class="relative border-t border-gold/20 bg-black/25">
    <div class="container-x flex flex-col items-center justify-between gap-3 py-5 text-sm sm:flex-row">
      <p>© {year} {company.legalName} All rights reserved.</p>
      <a href="#" class="group inline-flex items-center gap-3 text-white/70 hover:text-gold-soft">
        Back to top
        <span class="grid size-9 place-items-center rounded-full border border-gold-soft/40 text-gold-soft transition-all duration-300 group-hover:-translate-y-1 group-hover:bg-gold-soft group-hover:text-navy">
          <Icon name="ArrowRight" size={14} className="-rotate-90" />
        </span>
      </a>
    </div>
  </div>
</footer>

<style>
  /* Links: thin gold underline grows from the left on hover */
  .ft-link { background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; padding-bottom: 2px; transition: background-size .4s cubic-bezier(.2,.7,.2,1), color .3s; }
  .ft-link:hover, .ft-link:focus-visible { background-size: 100% 1px; }
</style>
