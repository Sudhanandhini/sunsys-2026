---
// Home banner: auto-advancing slider. Copy and image change together; stats and seal stay put.
import { company, stats } from '../data/site';

const years = new Date().getFullYear() - company.founded;
const pad = (n: number) => String(n).padStart(2, '0');
const btnDark = 'btn !rounded-[2px] bg-navy px-7 py-3.5 text-[13px] font-bold uppercase tracking-[.14em] text-white shadow-lg shadow-navy/15 transition-all hover:-translate-y-0.5 hover:bg-gold hover:shadow-gold/25';
const btnLine = 'btn !rounded-[2px] border border-navy/30 px-7 py-3.5 text-[13px] font-bold uppercase tracking-[.14em] text-navy hover:border-navy hover:bg-navy hover:text-white';

const slides = [
  {
    eyebrow: `Est. ${company.founded} · Bengaluru`,
    title: ['Custom websites that ', 'elevate', ' your brand'],
    text: 'Easy-to-navigate websites, online stores and web applications, designed around your business and built to work on every screen.',
    cta: { label: 'Get a free quote', href: '/contact?type=quote' },
    alt: { label: 'Explore services', href: '/services' },
    img: '/images/team.jpg',
    imgAlt: 'The Sunsys Technologies team at the Bengaluru office',
    pos: 'center',
  },
  {
    eyebrow: 'Custom web development',
    title: ['Web apps that ', 'simplify', ' the way you work'],
    text: 'Portals, dashboards and business tools built around your process, so your team spends less time on admin and more on customers.',
    cta: { label: 'Discuss your project', href: '/contact?type=quote' },
    alt: { label: 'Learn more', href: '/services/custom-web-development' },
    img: '/images/vision.jpg',
    imgAlt: 'Three colleagues reviewing a project on a laptop',
    pos: '55% center',
  },
  {
    eyebrow: 'E-commerce development',
    title: ['Online stores built to ', 'sell', ''],
    text: 'Product catalogues, secure payments and simple order management, so customers can buy from you on any device.',
    cta: { label: 'Get a free quote', href: '/contact?type=quote' },
    alt: { label: 'Learn more', href: '/services/ecommerce-development' },
    img: '/images/mission.jpg',
    imgAlt: 'Team members pointing at charts in a printed report',
    pos: 'center',
  },
  {
    eyebrow: 'Hosting & care',
    title: ['A local team that keeps you ', 'online', ''],
    text: 'Fast, secure hosting and ongoing maintenance, with support from people in Bengaluru who already know your website.',
    cta: { label: 'Maintenance plans', href: '/services/website-maintenance' },
    alt: { label: 'Contact us', href: '/contact' },
    img: '/images/industry-team.jpg',
    imgAlt: 'Sunsys developers standing together in the office',
    pos: 'center top',
  },
];
---
<section class="hero-slider relative overflow-hidden bg-ivory" aria-roledescription="carousel" aria-label="Highlights" data-slider>
  <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 hidden w-[38%] bg-cream lg:block"></div>
  <div class="container-x relative grid grid-cols-1 items-center gap-14 py-16 md:py-24 lg:grid-cols-[1.1fr_1fr]">
    <div class="min-w-0">
      <!-- slide copy: stacked in one grid cell so the tallest slide sets the height -->
      <div class="grid" aria-live="off" data-copy>
        {slides.map((s, i) => (
          <div class={`hs-copy col-start-1 row-start-1 ${i ? "" : "is-active"}`} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`} data-slide={i} aria-hidden={i ? 'true' : undefined} inert={i ? true : undefined}>
            <p class="eyebrow hs-in" style="--i:0">{s.eyebrow}</p>
            {i === 0
              ? <h1 class="hs-in mt-6 font-serif text-[38px] font-light leading-[1.04] tracking-[-0.035em] text-ink sm:text-[44px] md:text-[72px]" style="--i:1">{s.title[0]}<em class="font-normal text-gold">{s.title[1]}</em>{s.title[2]}</h1>
              : <h2 class="hs-in mt-6 font-serif text-[38px] font-light leading-[1.04] tracking-[-0.035em] text-ink sm:text-[44px] md:text-[72px]" style="--i:1">{s.title[0]}<em class="font-normal text-gold">{s.title[1]}</em>{s.title[2]}</h2>}
            <span aria-hidden="true" class="hs-line mt-8 block h-px w-28 bg-gold"></span>
            <p class="lead hs-in mt-8" style="--i:2">{s.text}</p>
            <div class="hs-in mt-10 flex flex-wrap gap-3" style="--i:3">
              <a href={s.cta.href} class={btnDark}>{s.cta.label}</a>
              <a href={s.alt.href} class={btnLine}>{s.alt.label}</a>
            </div>
          </div>
        ))}
      </div>

      <!-- controls -->
      <div class="mt-12 flex flex-wrap items-center gap-x-5 gap-y-4 anim-rise" style="--d:.6s">
        <span class="font-serif text-sm tabular-nums text-navy"><span data-current>01</span><span class="text-gold"> / </span>{pad(slides.length)}</span>
        <ol class="flex gap-2">
          {slides.map((s, i) => (
            <li>
              <button type="button" class="group relative block h-6 w-7 cursor-pointer sm:w-10 md:w-14" aria-label={`Show slide ${i + 1}: ${s.eyebrow}`} aria-current={i ? undefined : 'true'} data-dot={i}>
                <span class="absolute inset-x-0 top-1/2 h-0.5 -translate-y-1/2 bg-navy/15 transition-colors group-hover:bg-navy/30"></span>
                <span class="hs-bar absolute inset-x-0 top-1/2 h-0.5 -translate-y-1/2 origin-left scale-x-0 bg-gold"></span>
              </button>
            </li>
          ))}
        </ol>
        <div class="ml-auto flex gap-2 lg:ml-2">
          <button type="button" class="grid size-11 cursor-pointer place-items-center rounded-full border border-navy/25 text-navy transition-colors hover:border-navy hover:bg-navy hover:text-white" aria-label="Previous slide" data-prev>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
          </button>
          <button type="button" class="grid size-11 cursor-pointer place-items-center rounded-full border border-navy/25 text-navy transition-colors hover:border-navy hover:bg-navy hover:text-white" aria-label="Next slide" data-next>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
          </button>
          <button type="button" class="grid size-11 cursor-pointer place-items-center rounded-full border border-navy/25 text-navy transition-colors hover:border-navy hover:bg-navy hover:text-white" aria-label="Pause slideshow" data-toggle>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" data-icon-pause><path d="M7 5h3v14H7zM14 5h3v14h-3z" /></svg>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" class="hidden" data-icon-play><path d="M8 5v14l11-7z" /></svg>
          </button>
        </div>
      </div>

      <dl class="mt-10 grid max-w-md grid-cols-3 divide-x divide-gold/30 border-t border-gold/30 pt-6 anim-rise" style="--d:.7s">
        {stats.filter((s) => s.label !== 'Team members').map((s) => (
          <div class="flex min-w-0 flex-col-reverse px-3 first:pl-0 sm:px-4">
            <dt class="mt-1 text-[10px] font-semibold uppercase tracking-[.12em] text-body/80 sm:text-[11px] sm:tracking-[.16em]">{s.label}</dt>
            <dd class="font-serif text-[23px] leading-none text-navy sm:text-[28px] md:text-[32px]">{s.value.toLocaleString('en-IN')}<span class="text-gold">{s.suffix}</span></dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="relative mx-auto w-full max-w-[440px] anim-rise" style="--d:.25s">
      <div aria-hidden="true" class="absolute inset-0 translate-x-4 translate-y-4 rounded-t-full border border-gold"></div>
      <div class="relative aspect-[4/5] overflow-hidden rounded-t-full bg-cream shadow-2xl shadow-navy/15" data-swipe>
        {slides.map((s, i) => (
          <img src={s.img} alt={s.imgAlt} width="709" height="600" loading={i ? 'lazy' : 'eager'} fetchpriority={i ? undefined : 'high'}
            class={`hs-img absolute inset-0 size-full object-cover ${i ? "" : "is-active"}`} style={`object-position:${s.pos}`} data-img={i} aria-hidden={i ? 'true' : undefined} />
        ))}
      </div>
      <!-- rotating seal -->
      <div class="absolute -bottom-6 -left-2 grid size-28 place-items-center rounded-full bg-navy text-white shadow-xl sm:-bottom-8 sm:-left-8 sm:size-32 md:size-36">
        <svg viewBox="0 0 100 100" class="absolute inset-0 size-full anim-spin" aria-hidden="true">
          <defs><path id="seal" d="M50 50m-38 0a38 38 0 1 1 76 0a38 38 0 1 1-76 0" /></defs>
          <text font-size="8.4" letter-spacing="2.6" fill="#d9c39b" font-family="Manrope Variable, Manrope, sans-serif" font-weight="700">
            <textPath href="#seal">SUNSYS TECHNOLOGIES · SINCE {company.founded} ·</textPath>
          </text>
        </svg>
        <span class="text-center leading-none"><span class="block font-serif text-3xl">{years}+</span><span class="mt-1 block text-[10px] uppercase tracking-[.2em] text-white/70">years</span></span>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* Copy: hidden slides fade out; the active one staggers its lines in */
  .hero-slider .hs-copy { visibility: hidden; opacity: 0; transition: opacity .5s ease, visibility 0s linear .5s; }
  .hero-slider .hs-copy.is-active { visibility: visible; opacity: 1; transition: opacity .5s ease; }
  .hero-slider .hs-copy .hs-in { opacity: 0; transform: translateY(24px); }
  .hero-slider .hs-copy.is-active .hs-in { animation: rise .9s cubic-bezier(.2,.7,.2,1) forwards; animation-delay: calc(.1s + var(--i, 0) * .12s); }
  .hero-slider .hs-line { transform-origin: left; transform: scaleX(0); }
  .hero-slider .hs-copy.is-active .hs-line { animation: draw 1.1s cubic-bezier(.65,0,.35,1) .45s forwards; }

  /* Images: crossfade with a slow zoom-out */
  .hero-slider .hs-img { opacity: 0; transform: scale(1.12); transition: opacity 1.1s ease, transform 0s linear 1.1s; }
  .hero-slider .hs-img.is-active { opacity: 1; transform: scale(1); transition: opacity 1.1s ease, transform 6.5s cubic-bezier(.2,.7,.2,1); }

  /* Indicator bar fills over the autoplay interval */
  .hero-slider [aria-current="true"] .hs-bar { transform: scaleX(1); }
  .hero-slider.is-playing [aria-current="true"] .hs-bar { animation: draw var(--hs-delay, 6s) linear forwards; }
  .hero-slider.is-paused [aria-current="true"] .hs-bar { animation-play-state: paused; }

  @media (prefers-reduced-motion: reduce) {
    .hero-slider .hs-copy .hs-in, .hero-slider .hs-line { opacity: 1 !important; transform: none !important; }
    .hero-slider .hs-img.is-active { transform: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-slider]');
  if (root) {
    const copies = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const imgs = [...root.querySelectorAll<HTMLElement>('[data-img]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const current = root.querySelector('[data-current]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const DELAY = 6000;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let timer = 0;
    let userPaused = reduced; // reduced motion: no autoplay unless the visitor presses play
    let hoverPaused = false;

    root.style.setProperty('--hs-delay', `${DELAY}ms`);

    const go = (n: number) => {
      index = (n + copies.length) % copies.length;
      copies.forEach((el, i) => {
        const on = i === index;
        el.classList.toggle('is-active', on);
        el.toggleAttribute('inert', !on);
        on ? el.removeAttribute('aria-hidden') : el.setAttribute('aria-hidden', 'true');
      });
      imgs.forEach((el, i) => el.classList.toggle('is-active', i === index));
      dots.forEach((el, i) => (i === index ? el.setAttribute('aria-current', 'true') : el.removeAttribute('aria-current')));
      current.textContent = String(index + 1).padStart(2, '0');
      restart();
    };

    // restart the timer and the progress bar on the current dot
    const restart = () => {
      root.classList.remove('is-playing');
      void root.offsetWidth;
      schedule();
    };

    const schedule = () => {
      clearTimeout(timer);
      const playing = !userPaused && !hoverPaused && !document.hidden;
      root.classList.toggle('is-playing', !userPaused);
      root.classList.toggle('is-paused', !playing);
      if (playing) timer = window.setTimeout(() => go(index + 1), DELAY);
    };

    const setUserPaused = (p: boolean) => {
      userPaused = p;
      toggle.setAttribute('aria-label', p ? 'Play slideshow' : 'Pause slideshow');
      toggle.querySelector('[data-icon-pause]')!.classList.toggle('hidden', p);
      toggle.querySelector('[data-icon-play]')!.classList.toggle('hidden', !p);
      restart();
    };

    root.querySelector('[data-prev]')!.addEventListener('click', () => go(index - 1));
    root.querySelector('[data-next]')!.addEventListener('click', () => go(index + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    toggle.addEventListener('click', () => setUserPaused(!userPaused));

    // Pause while the visitor is reading or interacting
    root.addEventListener('mouseenter', () => { hoverPaused = true; schedule(); });
    root.addEventListener('mouseleave', () => { hoverPaused = false; restart(); });
    root.addEventListener('focusin', () => { hoverPaused = true; schedule(); });
    root.addEventListener('focusout', (e) => { if (!root.contains(e.relatedTarget as Node)) { hoverPaused = false; restart(); } });
    document.addEventListener('visibilitychange', restart);

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(index - 1);
      if (e.key === 'ArrowRight') go(index + 1);
    });

    // Swipe on the image
    const swipe = root.querySelector<HTMLElement>('[data-swipe]')!;
    let x0: number | null = null;
    swipe.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    swipe.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) go(index + (dx < 0 ? 1 : -1));
      x0 = null;
    });

    if (reduced) setUserPaused(true);
    go(0);
  }
</script>
