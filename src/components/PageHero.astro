---
// Inner-page banner: navy with gold accents and serif title, matching the home page.
// `accent` (optional) is a word or phrase inside `title` shown in gold italics.
// `image` (optional) shows a photo in an arch on the right instead of the outline motif.
import Photo from './Photo.astro';
interface Props { title: string; intro?: string; eyebrow?: string; accent?: string; image?: string; crumbs?: { label: string; href?: string }[] }
const { title, intro, eyebrow, accent, image, crumbs = [] } = Astro.props;
const parts = accent && title.includes(accent) ? title.split(accent) : null;
---
<section class="relative overflow-hidden bg-navy text-white">
  <div aria-hidden="true" class="pointer-events-none absolute -right-40 -top-40 size-[34rem] rounded-full bg-gold/15 blur-3xl"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -bottom-48 -left-32 size-[28rem] rounded-full bg-brand/25 blur-3xl"></div>
  <!-- fine dot grid -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-60 [background:radial-gradient(rgb(217_195_155/.14)_1px,transparent_1.4px)_0_0/22px_22px] [mask-image:linear-gradient(90deg,transparent,#000_60%)]"></div>
  {!image && (
    <>
      <!-- arch outline motif -->
      <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 right-[8%] hidden h-[26rem] w-[19rem] rounded-t-full border border-gold-soft/25 lg:block anim-rise" style="--d:.4s"></div>
      <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 right-[calc(8%+2rem)] hidden h-[22rem] w-[15rem] rounded-t-full border border-gold-soft/15 lg:block anim-rise" style="--d:.55s"></div>
    </>
  )}

  <div class={`container-x relative py-16 md:py-24 ${image ? 'grid items-center gap-12 lg:grid-cols-[1.4fr_1fr]' : ''}`}>
    <div>
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-6 text-[12px] font-semibold uppercase tracking-[.16em] text-white/55 anim-rise">
        <ol class="flex flex-wrap items-center gap-3">
          <li><a href="/" class="hover:text-gold-soft">Home</a></li>
          {crumbs.map((c) => (
            <li class="flex items-center gap-3">
              <span aria-hidden="true" class="size-1 rotate-45 bg-gold-soft/70"></span>
              {c.href ? <a href={c.href} class="hover:text-gold-soft">{c.label}</a> : <span class="text-gold-soft" aria-current="page">{c.label}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow !text-gold-soft anim-rise" style="--d:.05s">{eyebrow}</p>}
    <h1 class="mt-4 max-w-3xl font-serif text-[40px] font-light leading-[1.05] tracking-[-0.03em] !text-white anim-rise md:text-[64px]" style="--d:.12s">
      {parts ? <>{parts[0]}<em class="font-normal text-gold-soft">{accent}</em>{parts.slice(1).join(accent)}</> : title}
    </h1>
    <span aria-hidden="true" class="mt-7 block h-px w-24 bg-gold-soft anim-draw" style="--d:.45s"></span>
    {intro && <p class="lead mt-6 !text-white/75 anim-rise" style="--d:.3s">{intro}</p>}
    </div>
    {image && (
      <div class="relative mx-auto hidden w-full max-w-[300px] lg:block">
        <div aria-hidden="true" class="ph-outline absolute inset-0 translate-x-4 translate-y-4 rounded-t-full border border-gold-soft/60"></div>
        <div class="ph-arch relative overflow-hidden rounded-t-full shadow-2xl shadow-black/30">
          <Photo src={image} alt="" sizes="300px" class="ph-img aspect-[4/5] w-full object-cover" />
          <span aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-navy/50 to-transparent"></span>
        </div>
      </div>
    )}
  </div>
</section>

<style is:global>
  /* Banner photo: arch opens upward and the image settles, outline slides into place */
  @keyframes ph-open { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes ph-settle { from { transform: scale(1.3); } to { transform: none; } }
  @keyframes ph-outline { from { opacity: 0; translate: 0 0; } }
  .ph-arch { animation: ph-open 1.4s cubic-bezier(.65,0,.35,1) .2s both; }
  .ph-img { animation: ph-settle 2s cubic-bezier(.2,.7,.2,1) .35s both; }
  .ph-outline { animation: ph-outline 1s cubic-bezier(.2,.7,.2,1) 1s both; }
  @media (prefers-reduced-motion: reduce) { .ph-arch, .ph-img, .ph-outline { animation: none !important; } }
</style>
