---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="container-x grid min-h-[50vh] place-items-center py-24 text-center">
    <div>
      <p class="font-head text-6xl font-bold text-brand">404</p>
      <h1 class="h-section mt-4">This page doesn’t exist</h1>
      <p class="mt-3">The link may be old or mistyped. Try the home page or our services.</p>
      <div class="mt-8 flex justify-center gap-3"><a href="/" class="btn btn-primary">Go to home</a><a href="/services" class="btn btn-outline">View services</a></div>
    </div>
  </section>
</Base>
