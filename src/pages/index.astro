---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import aboutTeam from '../images/about.png';
import Icon from '../components/Icon.jsx';
import Stats from '../components/Stats.jsx';
import Newsletter from '../components/Newsletter.jsx';
import HeroSlider from '../components/HeroSlider.astro';
import GlobalPresence from '../components/GlobalPresence.astro';
import IndustriesShowcase from '../components/IndustriesShowcase.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import QuoteCta from '../components/QuoteCta.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import { company, services, stats, ratings, partners } from '../data/site';
const hosting = services.filter((s) => s.group === 'hosting');
const years = new Date().getFullYear() - company.founded;
const pad = (n: number) => String(n).padStart(2, '0');
const btnDark = 'btn !rounded-[2px] bg-navy px-7 py-3.5 text-[13px] font-bold uppercase tracking-[.14em] text-white shadow-lg shadow-navy/15 transition-all hover:-translate-y-0.5 hover:bg-gold hover:shadow-gold/25';
---
<Base title="Home">

  <!-- Hero slider -->
  <HeroSlider />

  <!-- Ratings + partners -->
  <section class="border-y border-gold/25 bg-white">
    <div class="container-x grid gap-8 py-9 md:grid-cols-[auto_1fr] md:items-center md:gap-16" data-reveal="fade">
      <ul class="flex flex-wrap gap-x-10 gap-y-5">
        {ratings.map((r) => (
          <li>
            <p class="font-serif text-lg text-ink">{r.name}</p>
            <p class="mt-1 flex items-center gap-1 text-gold" aria-label={r.text}>
              {[1, 2, 3, 4, 5].map((i) => (
                <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                  <defs><linearGradient id={`g${r.name}${i}`}><stop offset={`${Math.max(0, Math.min(1, r.score - i + 1)) * 100}%`} stop-color="currentColor" /><stop offset="0" stop-color="#e4dccd" /></linearGradient></defs>
                  <path fill={`url(#g${r.name}${i})`} d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1Z" />
                </svg>
              ))}
              <span class="ml-1 text-sm font-bold text-ink">{r.score}</span>
            </p>
          </li>
        ))}
      </ul>
      <div class="md:border-l md:border-gold/25 md:pl-16">
        <p class="text-[11px] font-semibold uppercase tracking-[.22em] text-gold">Partners and certifications</p>
        <ul class="mt-2 flex flex-wrap gap-x-6 gap-y-2 font-serif text-[17px] text-ink">
          {partners.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Web development -->
  <ServicesGrid />

  <!-- About -->
  <section class="relative overflow-hidden bg-[#062a52] py-20 text-white md:py-28">
    <div aria-hidden="true" class="pointer-events-none absolute -right-40 -top-40 size-[30rem] rounded-full bg-gold/10 blur-3xl"></div>
    <div class="container-x relative grid items-center gap-16 lg:grid-cols-2">
      <div class="relative" data-reveal="left">
        <div aria-hidden="true" class="absolute -top-5 -left-5 h-2/3 w-2/3 border-t border-l border-gold-soft"></div>
        <div class="relative overflow-hidden shadow-2xl shadow-black/30">
          <Image src={aboutTeam} alt="The Sunsys Technologies team at the Bengaluru office" widths={[560, 1120]} sizes="(min-width: 1024px) 560px, 100vw" format="webp" loading="lazy" class="aspect-square w-full origin-[30%_0%] scale-110 object-cover" />
        </div>
        <div class="absolute -right-4 -bottom-8 bg-gold px-8 py-6 text-navy shadow-xl md:-right-8">
          <p class="font-serif text-5xl font-light leading-none">{years}<span class="text-white">+</span></p>
          <p class="mt-2 text-[11px] font-semibold uppercase tracking-[.2em] text-navy/75">years of craft</p>
        </div>
      </div>
      <div data-reveal="right">
        <p class="eyebrow !text-gold-soft">Our story</p>
        <h2 class="h-classic mt-4 !text-white">A trusted website design company in Bangalore</h2>
        <blockquote class="mt-7 border-l-2 border-gold-soft pl-6 font-serif text-[22px] font-light italic leading-relaxed text-gold-soft">
          Quality work at a fair price, since {company.founded}.
        </blockquote>
        <p class="lead mt-6 !text-white/75">Founded by {company.founder} in May {company.founded}, Sunsys Technologies started as a web services provider and was registered as {company.legalName} in May {company.registered}.</p>
        <p class="lead mt-4 !text-white/75">Today we design, build and host websites for businesses in India, Dubai, the UK, the USA and beyond.</p>
        <a href="/about" class="btn mt-9 !rounded-[2px] bg-gold px-7 py-3.5 text-[13px] font-bold uppercase tracking-[.14em] text-navy shadow-lg shadow-black/20 transition-all hover:-translate-y-0.5 hover:bg-white">About our company</a>
      </div>
    </div>
    <div class="container-x relative mt-24" data-reveal>
      <div class="border-y border-gold-soft/25 bg-white/[.04]"><Stats client:visible items={stats} classic dark /></div>
    </div>
  </section>

  <!-- Hosting (animated with GSAP, see script at the end) -->
  <section class="relative overflow-hidden bg-white py-20 md:py-28" data-host>
    <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 hidden w-[34%] bg-ivory lg:block"></div>
    <div class="container-x relative grid items-center gap-16 lg:grid-cols-[5fr_6fr] lg:gap-20">

      <!-- image composition -->
      <div class="relative mx-auto w-full max-w-[520px] pb-10 lg:pb-0">
        <div aria-hidden="true" class="absolute -top-5 -left-5 h-3/4 w-3/4 border-t border-l border-gold" data-host-frame></div>
        <div class="relative overflow-hidden shadow-2xl shadow-navy/15" data-host-img>
          <img src="/images/vision.jpg" alt="Sunsys support team checking a client website on a laptop" width="685" height="343" loading="lazy" class="aspect-[4/3] w-full scale-[1.02] object-cover" data-host-img-inner />
          <span aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-navy/45 via-transparent to-transparent"></span>
        </div>

        <!-- floating server status card -->
        <div class="host-float absolute -bottom-2 -right-3 w-56 rounded-xl bg-navy p-4 text-white shadow-2xl shadow-navy/30 md:-right-10 md:w-60" data-host-card aria-hidden="true">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold uppercase tracking-[.18em] text-gold-soft">Server status</span>
            <span class="flex items-center gap-1.5 text-[11px] font-semibold text-[#7ee2a8]"><span class="host-led size-1.5 rounded-full bg-[#28c840]"></span>Online</span>
          </div>
          <div class="mt-3 space-y-1.5">
            {[72, 48, 86].map((w, r) => (
              <div class="flex items-center gap-2 rounded bg-white/[.07] px-2.5 py-2">
                <span class="host-led size-1.5 rounded-full bg-[#28c840]" style={`animation-delay:${r * 0.4}s`}></span>
                <span class="host-led size-1.5 rounded-full bg-gold-soft" style={`animation-delay:${0.2 + r * 0.5}s`}></span>
                <span class="h-1 flex-1 overflow-hidden rounded bg-white/15"><span class="host-bar block h-full rounded bg-gold-soft/70" style={`--w:${w}%;animation-delay:${r * 0.7}s`}></span></span>
              </div>
            ))}
          </div>
        </div>

        <!-- floating feature badges (from the hosting plans) -->
        <span class="host-float absolute -top-3 right-6 inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-[13px] font-semibold text-ink shadow-lg shadow-navy/15 md:-right-6" style="animation-delay:-2s" data-host-chip>
          <Icon name="Check" size={14} strokeWidth={2.5} className="text-gold" />Free SSL
        </span>
        <span class="host-float absolute bottom-24 -left-3 inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-[13px] font-semibold text-ink shadow-lg shadow-navy/15 md:-left-8" style="animation-delay:-4s" data-host-chip>
          <Icon name="Check" size={14} strokeWidth={2.5} className="text-gold" />Daily backups
        </span>
      </div>

      <!-- copy + services -->
      <div>
        <p class="eyebrow" data-host-fade>Care & hosting</p>
        <h2 class="h-classic mt-4" data-host-title>Hosting &amp; <em class="text-gold">maintenance</em></h2>
        <p class="lead mt-4" data-host-fade>Keep your website fast, secure and online, with local support from our Bengaluru team.</p>

        <ul class="mt-10 border-t border-line">
          {hosting.map((s) => (
            <li class="relative" data-host-row>
              <span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-px origin-left bg-line" data-host-line></span>
              <a href={`/services/${s.slug}`} class="group relative grid grid-cols-[auto_1fr_auto] items-start gap-5 py-6 pr-2 transition-[padding] duration-500 hover:pl-3 md:gap-6">
                <span aria-hidden="true" class="absolute inset-0 origin-left scale-x-0 bg-ivory transition-transform duration-500 group-hover:scale-x-100"></span>
                <span class="relative grid size-14 place-items-center rounded-full border border-gold/50 text-navy transition-colors duration-500 group-hover:border-navy group-hover:bg-navy group-hover:text-gold-soft" data-host-icon>
                  <Icon name={s.icon} size={24} strokeWidth={1.4} />
                </span>
                <span class="relative min-w-0">
                  <span class="block font-serif text-[22px] leading-tight tracking-[-0.015em] text-ink transition-colors group-hover:text-gold" data-host-copy>{s.title}</span>
                  <span class="mt-1.5 block text-[15px] leading-6" data-host-copy>{s.summary}</span>
                  <span class="mt-3 flex flex-wrap gap-1.5">
                    {s.points.slice(0, 2).map((pt) => (
                      <span class="border border-gold/35 bg-white/70 px-2.5 py-1 text-[12px] text-body" data-host-pt>{pt}</span>
                    ))}
                  </span>
                </span>
                <span aria-hidden="true" class="relative mt-3 grid size-10 place-items-center rounded-full border border-line text-navy transition-all duration-500 group-hover:-rotate-45 group-hover:border-gold group-hover:bg-gold group-hover:text-white">
                  <Icon name="ArrowRight" size={16} strokeWidth={1.8} />
                </span>
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-9 flex flex-wrap items-center gap-6" data-host-fade>
          <a href="/services/website-maintenance" class={btnDark}>See maintenance plans</a>
          <a href="/contact?type=quote" class="inline-flex items-center gap-2 border-b border-gold pb-1 text-[13px] font-semibold uppercase tracking-[.15em] text-navy hover:text-gold">Ask about hosting <Icon name="ArrowRight" size={14} strokeWidth={2} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Industries -->
  <IndustriesShowcase />

  <!-- Process -->
  <ProcessSteps />

  <!-- Global presence + clients -->
  <GlobalPresence />

  <!-- CTA + quote form -->
  <QuoteCta />

  <!-- Newsletter -->
 

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { SplitText } from 'gsap/SplitText';
    import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';

    gsap.registerPlugin(ScrollTrigger, SplitText, DrawSVGPlugin);

    // Hosting
    const host = document.querySelector<HTMLElement>('[data-host]');
    if (host) {
      const q = gsap.utils.selector(host);
      gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
        const st = { trigger: host, start: 'top 70%' };

        // Image wipes open from the left while zooming out; frame lines draw in; cards float up
        gsap.timeline({ scrollTrigger: st })
          .from(q('[data-host-img]'), { clipPath: 'inset(0 100% 0 0)', duration: 1.4, ease: 'expo.inOut' })
          .from(q('[data-host-img-inner]'), { scale: 1.3, duration: 1.8, ease: 'expo.out' }, '<0.2')
          .from(q('[data-host-frame]'), { clipPath: 'inset(0 100% 100% 0)', duration: 1.2, ease: 'power3.inOut' }, '<0.3')
          .from(q('[data-host-card]'), { y: 60, autoAlpha: 0, duration: 0.9, ease: 'back.out(1.4)' }, '-=0.7')
          .from(q('[data-host-chip]'), { scale: 0.5, autoAlpha: 0, duration: 0.6, stagger: 0.15, ease: 'back.out(2)' }, '-=0.5');

        // Gentle parallax on the photo while scrolling
        gsap.to(q('[data-host-img-inner]'), {
          yPercent: -8, ease: 'none',
          scrollTrigger: { trigger: host, start: 'top bottom', end: 'bottom top', scrub: 1 },
        });

        SplitText.create(q('[data-host-title]'), { type: 'lines', mask: 'lines', autoSplit: true,
          onSplit: (self) => gsap.from(self.lines, { yPercent: 110, duration: 1.1, stagger: 0.12, ease: 'expo.out', scrollTrigger: st }),
        });
        gsap.from(q('[data-host-fade]'), { y: 20, autoAlpha: 0, duration: 0.9, stagger: 0.15, ease: 'power3.out', delay: 0.2, scrollTrigger: st });

        // Rows: divider draws, icon pops with its strokes drawing, copy slides in, feature tags pop
        q('[data-host-row]').forEach((row: HTMLElement, i: number) => {
          gsap.timeline({ scrollTrigger: { trigger: row, start: 'top 90%' }, delay: i * 0.12 })
            .from(row.querySelector('[data-host-line]'), { scaleX: 0, duration: 1, ease: 'power3.inOut' })
            .from(row.querySelector('[data-host-icon]'), { scale: 0.3, rotate: -60, autoAlpha: 0, duration: 0.8, ease: 'back.out(1.8)' }, '<0.1')
            .from(row.querySelectorAll('[data-host-icon] svg > *'), { drawSVG: 0, duration: 0.9, stagger: 0.08, ease: 'power2.inOut' }, '<0.15')
            .from(row.querySelectorAll('[data-host-copy]'), { x: 30, autoAlpha: 0, duration: 0.8, stagger: 0.08, ease: 'power3.out' }, '<')
            .from(row.querySelectorAll('[data-host-pt]'), { scale: 0.7, autoAlpha: 0, duration: 0.45, stagger: 0.06, ease: 'back.out(2)' }, '-=0.4');
        });
      });
    }
  </script>
</Base>
