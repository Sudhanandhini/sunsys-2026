---
import fs from 'node:fs';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.jsx';
import { industries, services } from '../../data/site';
import { industryDetails } from '../../data/details';

export function getStaticPaths() {
  return industries.map((i) => ({ params: { slug: i.slug }, props: { industry: i } }));
}
const { industry } = Astro.props;
const detail = industryDetails[industry.slug];
const exists = (p: string) => fs.existsSync(`public${p}`);
const indPhoto = (slug: string) => (exists(`/images/industries/${slug}.jpg`) ? `/images/industries/${slug}.jpg` : undefined);
const svcPhoto = (slug: string) => (exists(`/images/services/${slug}.jpg`) ? `/images/services/${slug}.jpg` : undefined);
const fit = (detail?.services ?? ['website-development', 'responsive-web-design', 'cms-web-development', 'website-maintenance'])
  .map((s) => services.find((x) => x.slug === s)!)
  .filter(Boolean);
const others = industries.filter((i) => i.slug !== industry.slug);
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI'];
---
<Base title={`${industry.title} Websites`} description={industry.summary}>
  <PageHero
    eyebrow="Industry solutions"
    title={`Websites for ${industry.title.toLowerCase()}`}
    accent={industry.title.toLowerCase()}
    intro={industry.summary}
    image={indPhoto(industry.slug)}
    crumbs={[{ label: 'Services', href: '/services' }, { label: industry.title }]}
  />

  <!-- Overview + features -->
  <section class="relative overflow-clip bg-ivory py-20 md:py-28">
    <div class="container-x">
      <div class="grid gap-8 lg:grid-cols-[7fr_5fr] lg:items-end lg:gap-20" data-reveal>
        <div>
          <p class="eyebrow">What your site needs</p>
          <h2 class="h-classic mt-4">Built for <em class="text-gold">{industry.title.toLowerCase()}</em></h2>
        </div>
        <p class="lead">{detail?.intro ?? industry.summary}</p>
      </div>

      {detail && (
        <ul class="mt-14 grid gap-px border border-gold/25 bg-gold/25 sm:grid-cols-2 lg:grid-cols-4">
          {detail.features.map((f, i) => (
            <li class="group relative bg-ivory p-8 transition-colors duration-500 hover:bg-white" data-reveal style={`--d:${i * 0.12}s`}>
              <span aria-hidden="true" class="absolute inset-x-0 top-0 h-0.5 origin-left scale-x-0 bg-gold transition-transform duration-500 group-hover:scale-x-100"></span>
              <span class="flex items-center gap-3 font-serif text-[15px] italic text-gold"><span class="h-px w-6 bg-gold/60 transition-all duration-500 group-hover:w-10"></span>{roman[i]}</span>
              <h3 class="mt-5 font-serif text-[22px] font-normal leading-snug text-ink">{f.title}</h3>
              <p class="mt-3 text-[15px] leading-relaxed">{f.text}</p>
            </li>
          ))}
        </ul>
      )}

      <!-- quote strip -->
      <div class="relative mt-14 flex flex-col items-start justify-between gap-6 overflow-hidden bg-navy px-8 py-9 text-white md:flex-row md:items-center md:px-12" data-reveal>
        <div aria-hidden="true" class="pointer-events-none absolute -right-16 -top-20 size-64 rounded-full bg-gold/20 blur-3xl"></div>
        <div class="relative flex items-center gap-5">
          <span class="grid size-14 shrink-0 place-items-center rounded-full border border-gold-soft/50 text-gold-soft"><Icon name={industry.icon} size={24} strokeWidth={1.4} /></span>
          <div>
            <p class="font-serif text-[24px] leading-tight">Planning a {industry.title.toLowerCase()} website?</p>
            <p class="mt-1 text-white/70">Tell us about your business and we will suggest the right pages and features.</p>
          </div>
        </div>
        <a href="/contact?type=quote" class="group relative inline-flex shrink-0 items-center gap-3 overflow-hidden rounded-[2px] bg-gold px-7 py-4 text-[13px] font-bold uppercase tracking-[.14em] text-navy">
          <span aria-hidden="true" class="absolute inset-0 origin-left scale-x-0 bg-white transition-transform duration-500 group-hover:scale-x-100"></span>
          <span class="relative">Request a quote</span>
          <Icon name="ArrowRight" size={15} strokeWidth={2} className="relative transition-transform group-hover:translate-x-1" />
        </a>
      </div>
    </div>
  </section>

  <!-- Services that fit -->
  <section class="bg-white py-20 md:py-28">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow">How we help</p>
        <h2 class="h-classic mt-4">Services that <em class="text-gold">fit</em></h2>
      </div>
      <ul class="mt-14 grid border-t border-gold/30 sm:grid-cols-2 lg:grid-cols-4">
        {fit.map((s, i) => (
          <li class="border-b border-gold/30 sm:odd:border-r lg:border-r lg:last:border-r-0" data-reveal style={`--d:${i * 0.12}s`}>
            <a href={`/services/${s.slug}`} class="rel-card group flex h-full flex-col items-center px-6 pb-10 pt-12 text-center transition-colors duration-500 hover:bg-ivory">
              <span class="relative block w-[70%] max-w-[190px]">
                <span aria-hidden="true" class="absolute inset-0 translate-x-2.5 translate-y-2.5 rounded-t-full border border-gold/70 transition-[translate] duration-700 group-hover:translate-x-0 group-hover:translate-y-0"></span>
                <span class="relative block aspect-[3/4] overflow-hidden rounded-t-full bg-navy">
                  {svcPhoto(s.slug) && <img src={svcPhoto(s.slug)} alt="" width="600" height="800" loading="lazy" class="rel-img size-full object-cover" />}
                </span>
              </span>
              <span class="mt-8 block font-serif text-[22px] leading-snug text-ink transition-colors group-hover:text-gold">{s.title}</span>
              <span class="mt-3 block max-w-[30ch] flex-1 text-[15px] leading-relaxed">{s.summary}</span>
              <span class="mt-6 inline-block border-b border-gold/60 pb-1 text-[11px] font-bold uppercase tracking-[.22em] text-navy">Discover</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ProcessSteps />

  {detail && <Faq items={detail.faqs} />}

  <!-- Other industries -->
  <section class="relative overflow-hidden bg-navy py-20 text-white md:py-28">
    <div aria-hidden="true" class="pointer-events-none absolute -left-40 top-1/3 size-[30rem] rounded-full bg-gold/10 blur-3xl"></div>
    <div class="container-x relative">
      <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
        <div>
          <p class="eyebrow !text-gold-soft">More sectors</p>
          <h2 class="h-classic mt-4 !text-white">Other <em class="text-gold-soft">industries</em></h2>
        </div>
      </div>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
        {others.map((o, i) => (
          <li data-reveal style={`--d:${i * 0.1}s`}>
            <a href={`/industries/${o.slug}`} class="rel-card group relative block aspect-[3/4] overflow-hidden rounded-t-[999px] bg-[#0b3a6e] ring-1 ring-white/10">
              {indPhoto(o.slug) && <img src={indPhoto(o.slug)} alt="" width="900" height="1100" loading="lazy" class="rel-img absolute inset-0 size-full object-cover" />}
              <span aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-navy via-navy/40 to-transparent"></span>
              <span class="absolute inset-x-0 bottom-0 p-5 text-center">
                <span class="mx-auto grid size-10 place-items-center rounded-full border border-gold-soft/50 text-gold-soft transition-colors duration-500 group-hover:bg-gold-soft group-hover:text-navy"><Icon name={o.icon} size={18} strokeWidth={1.5} /></span>
                <span class="mt-3 block font-serif text-[18px] leading-tight text-white">{o.title}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style is:global>
  .rel-card .rel-img { transition: transform 1.2s cubic-bezier(.2,.7,.2,1); }
  .rel-card:hover .rel-img { transform: scale(1.08); }
</style>
