---
import { url } from '../lib/url';
// Sitemap page for visitors (search engines use /sitemap.xml, generated by api/sitemap.php).
// Pages, services and industries come from the site data; blog articles load from the blog API.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.jsx';
import { services, industries } from '../data/site';

const groups = [
  {
    title: 'Company',
    icon: 'Building2',
    links: [['Home', '/'], ['About us', '/about'], ['Career', '/career'], ['Contact us', '/contact'], ['Get a free quote', '/contact?type=quote']],
  },
  {
    title: 'Web development',
    icon: 'CodeXml',
    links: [['All services', '/services'], ...services.filter((s) => s.group === 'web').map((s) => [s.title, `/services/${s.slug}`])],
  },
  {
    title: 'Hosting & care',
    icon: 'Server',
    links: services.filter((s) => s.group === 'hosting').map((s) => [s.title, `/services/${s.slug}`]),
  },
  {
    title: 'Industries',
    icon: 'Briefcase',
    links: industries.map((i) => [`${i.title} websites`, `/industries/${i.slug}`]),
  },
];
---
<Base title="Sitemap" description="Every page on the Sunsys Technologies website: services, industries, blog articles and company information.">
  <PageHero eyebrow="Find your way" title="Sitemap" accent="Sitemap" intro="Every page on our website in one place." crumbs={[{ label: 'Sitemap' }]} />

  <section class="bg-ivory py-20 md:py-24">
    <div class="container-x grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {groups.map((g) => (
        <nav aria-labelledby={`sm-${g.title}`} class="rounded-2xl bg-white p-8 ring-1 ring-gold/20" data-reveal>
          <div class="flex items-center gap-3">
            <span class="grid size-10 place-items-center rounded-full border border-gold/40 text-gold"><Icon name={g.icon} size={18} /></span>
            <h2 id={`sm-${g.title}`} class="font-serif text-[24px] text-ink">{g.title}</h2>
          </div>
          <ul class="mt-6 space-y-3 text-[15px]">
            {g.links.map(([label, href]) => (
              <li><a href={url(href)} class="sm-link group inline-flex items-start gap-2 text-body hover:text-navy"><span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rotate-45 bg-gold transition-transform group-hover:scale-125"></span>{label}</a></li>
            ))}
          </ul>
        </nav>
      ))}

      <nav aria-labelledby="sm-blog" class="rounded-2xl bg-white p-8 ring-1 ring-gold/20" data-reveal>
        <div class="flex items-center gap-3">
          <span class="grid size-10 place-items-center rounded-full border border-gold/40 text-gold"><Icon name="Newspaper" size={18} /></span>
          <h2 id="sm-blog" class="font-serif text-[24px] text-ink">Blog</h2>
        </div>
        <ul class="mt-6 space-y-3 text-[15px]" data-sm-posts>
          <li><a href={url('/blog')} class="sm-link group inline-flex items-start gap-2 text-body hover:text-navy"><span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rotate-45 bg-gold"></span>All articles</a></li>
        </ul>
      </nav>
    </div>
    <p class="container-x mt-10 text-center text-[14px] text-body/70">For search engines: <a href={url('/sitemap.xml')} class="text-navy underline decoration-gold underline-offset-4 hover:text-gold">sitemap.xml</a></p>
  </section>
</Base>

<style is:global>
  /* global: the blog links are added by the script below */
  .sm-link { background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size .4s cubic-bezier(.2,.7,.2,1), color .3s; }
  .sm-link:hover { background-size: 100% 1px; }
</style>

<script>
  import { url } from '../lib/url';

  // Published articles, newest first (the API lists only live posts)
  const list = document.querySelector('[data-sm-posts]');
  fetch(url('/api/posts.php'), { headers: { Accept: 'application/json' } })
    .then((r) => (r.ok ? r.json() : Promise.reject()))
    .then((d: { posts?: { slug: string; title: string }[] }) => {
      for (const p of d.posts ?? []) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = url(`/blog/post/?slug=${encodeURIComponent(p.slug)}`);
        a.className = 'sm-link group inline-flex items-start gap-2 text-body hover:text-navy';
        a.innerHTML = '<span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rotate-45 bg-gold"></span>';
        a.append(p.title);
        li.append(a);
        list?.append(li);
      }
    })
    .catch(() => {});
</script>
