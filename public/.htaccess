# Site root (public_html). Caching + compression only; folder rules live in admin/, api/ and uploads/.
# If cPanel added lines here (e.g. a PHP version handler), keep them when redeploying.

ErrorDocument 404 /404.html

# blog/post/ has both: index.php adds each article's SEO tags to the built index.html
DirectoryIndex index.php index.html

# SEO from Admin > SEO: pages go through api/page.php, which adds the tags set there to the built HTML.
# robots.txt and sitemap.xml are generated from the same settings.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^robots\.txt$ api/robots.php [L]
  RewriteRule ^sitemap\.xml$ api/sitemap.php [L]
  RewriteCond %{REQUEST_URI} !^/(api|admin|uploads|_astro|blog/post)(/|$)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ api/page.php [L]
</IfModule>

# Compress text responses
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Astro build output has content hashes in the file names, so it never changes: cache for a year
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Pages: always revalidate so a redeploy shows up straight away
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Un-hashed static files (logos, favicon)
  <FilesMatch "\.(png|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
